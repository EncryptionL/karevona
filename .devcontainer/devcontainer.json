{
  "name": "Karevona",
  "dockerComposeFile": ["../deploy/dev/docker-compose.yml"],
  "service": "dev",
  "runServices": ["dev", "web", "postgres", "valkey"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "dev",
  "forwardPorts": [3000, 5432, 6379, 7443],
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "vadimcn.vscode-lldb",
        "zxh404.vscode-proto3",
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "cmake.generator": "Ninja",
        "cmake.buildDirectory": "${workspaceFolder}/build-docker",
        "clangd.arguments": ["--compile-commands-dir=${workspaceFolder}/build-docker"]
      }
    }
  }
}
